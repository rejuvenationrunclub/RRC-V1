# Copy to .env and fill in. .env is git-ignored. NEVER commit real values.
# In production, set these in your host's secret manager instead of a file.

# --- Discord (see README "Discord Developer Portal setup") -------------------
# Bot token from Developer Portal > Bot > Reset Token. SECRET.
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID. Not secret.
DISCORD_APPLICATION_ID=
# Your server's ID (Discord Developer Mode > right-click server > Copy Server ID).
DISCORD_GUILD_ID=

# --- Database ----------------------------------------------------------------
# Used by docker-compose.yml to initialize the local PostgreSQL container.
POSTGRES_USER=rrc
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rrc
POSTGRES_PORT=5432

# SQLAlchemy async URL the bot and Alembic use. Must match the values above locally.
DATABASE_URL=postgresql+asyncpg://rrc:change-me-local-only@localhost:5432/rrc
# Separate database for the automated tests (created by docker/postgres/init).
TEST_DATABASE_URL=postgresql+asyncpg://rrc:change-me-local-only@localhost:5432/rrc_test

# --- App ---------------------------------------------------------------------
# Calendar display time zone. Storage is always UTC.
DISPLAY_TZ=America/Phoenix
LOG_LEVEL=INFO
